APP_NAME=MicroServices Template
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/app
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=change-this-to-a-long-random-value
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:5173
LOG_PERSISTENCE_ENABLED=true
LOG_RETENTION_DAYS=30
LOG_BODY_MAX_BYTES=262144
LOG_QUEUE_SIZE=10000
LOG_BATCH_SIZE=100
LOG_FLUSH_INTERVAL_SECONDS=0.5
LOG_CLEANUP_INTERVAL_SECONDS=86400
LOG_EXCLUDED_PATH_PREFIXES=/api/v1/logs,/health

